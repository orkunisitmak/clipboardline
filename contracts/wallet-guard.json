{
  "schemaVersion": 1,
  "description": "Wallet Guard: local crypto clipboard safety. Recovery phrases and private keys are withheld from history; same-chain address replacement inside a short window and lookalike addresses raise warnings. All values are public test vectors or synthetic data that hold no funds.",
  "setting": {
    "default": true,
    "macOSDefaultsKey": "walletGuardEnabled",
    "windowsSettingsKey": "walletGuard"
  },
  "wordlist": {
    "name": "BIP39 English",
    "count": 2048,
    "sha256OfNewlineTerminatedList": "2f5eed53a4727b4bf8880d8f3f199efc90e58503646d9ff8eff3a2ed3b24dbda"
  },
  "limits": {
    "maximumInspectedCharacters": 16384,
    "maximumMnemonicRunWords": 48,
    "hijackWindowMs": 3000,
    "lookalikePrefix": 4,
    "lookalikeSuffix": 4,
    "historyAddresses": 200,
    "sessionAddresses": 32
  },
  "notices": {
    "recoveryPhrase": "Recovery phrase not saved. Never paste it into websites or chats.",
    "privateKey": "Private key not saved. Never paste it into websites or chats."
  },
  "classify": [
