{
  "schemaVersion": 1,
  "description": "Copied content admission before history, previews, indexing or metadata. Private markers on any item exclude the whole copy; a copy that is only a payment card number (Luhn) or an IBAN (ISO 13616 mod 97) is excluded; nonblank text bytes stay exact. With link capture on, each linkedRepresentationCases row is saved as the link in url or as the exact text in text; a row runs on both platforms unless platforms names the only one that has its representation (see the rich-link-representations exception in shelf-behavior.json). With link capture off every row with text/plain is saved as that text.",
  "privateMarkers": [
    "org.nspasteboard.ConcealedType",
    "org.nspasteboard.TransientType",
    "org.nspasteboard.AutoGeneratedType",
    "com.agilebits.onepassword"
  ],
  "linkedRepresentationCases": [
    {
      "name": "HTML anchor with a plain display label",
      "formats": {"text/plain": "Read docs", "text/html": "<a href=\"https://example.com/docs?a=1&amp;b=2\">Read docs</a>"},
      "url": "https://example.com/docs?a=1&b=2"
    },
    {
      "name": "URI list with a comment and a display label",
      "platforms": ["windows"],
      "formats": {"text/plain": "Read docs", "text/uri-list": "# copied URL\r\nhttps://example.com/from-uri\r\n"},
      "url": "https://example.com/from-uri"
    },
    {
      "name": "only HTML URL no plain-text representation",
      "formats": {"text/html": "<a title='docs' href='https://example.com/html-only'>Read docs</a>"},
      "url": "https://example.com/html-only"
    },
    {
      "name": "styled anchor whose markup, entities and spacing differ from the label",
      "formats": {"text/plain": "Tom & Jerry docs", "text/html": "<meta charset='utf-8'><A class=link HREF=\"https://example.com/styled\"><b>Tom &amp;\n  Jerry</b>&nbsp;docs</A>"},
      "url": "https://example.com/styled"
    },
    {
      "name": "data-href before the real href is not the destination",
      "formats": {"text/plain": "Read docs", "text/html": "<a data-href=\"https://example.com/wrong\" title=\"href=https://example.com/also-wrong\" href=\"https://example.com/right\">Read docs</a>"},
      "url": "https://example.com/right"
    },
    {
      "name": "anchor with only data-href is not a link",
      "formats": {"text/plain": "Read docs", "text/html": "<a data-href=\"https://example.com/wrong\">Read docs</a>"},
      "text": "Read docs"
    },
    {
      "name": "paragraph that contains one link stays text",
      "formats": {"text/plain": "Read the docs before you start.", "text/html": "<p>Read the <a href=\"https://example.com/docs\">docs</a> before you start.</p>"},
      "text": "Read the docs before you start."
    },
    {
      "name": "two links are ambiguous",
      "formats": {"text/plain": "Read docs", "text/html": "<a href=\"https://example.com/a\">Read</a> <a href=\"https://example.com/b\">docs</a>"},
      "text": "Read docs"
    },
    {
      "name": "anchor inside an HTML comment is not a link",
      "formats": {"text/plain": "docs", "text/html": "<!-- <a href=\"https://example.com/wrong\">docs</a> --><span>docs</span>"},
      "text": "docs"
    },
    {
      "name": "unclosed HTML comment hides the anchor after it",
      "formats": {"text/plain": "docs", "text/html": "<span>docs</span><!-- <a href=\"https://example.com/wrong\">docs</a>"},
      "text": "docs"
    },
    {
      "name": "unsafe anchor destination",
      "formats": {"text/plain": "Read docs", "text/html": "<a href=\"javascript:alert(1)\">Read docs</a>"},
      "text": "Read docs"
    }
  ],
  "textCases": [
    {
      "name": "spaces",
      "value": "   ",
      "capture": false
    },
    {
      "name": "tabs and newlines",
      "value": "\t\r\n",
      "capture": false
    },
    {
      "name": "Unicode whitespace",
      "value": "    ",
      "capture": false
    },
    {
      "name": "padded exact text",
      "value": "  İstanbul 👨‍👩‍👧‍👦\r\nnext line\t",
      "capture": true
    },
    {
      "name": "zero width is content",
      "value": " ​ ",
      "capture": true
    },
    {
      "name": "BOM is content",
      "value": "﻿",
      "capture": true
    },
    {
      "name": "spaced card number",
      "value": "4111 1111 1111 1111",
      "capture": false
    },
    {
      "name": "hyphenated padded card number",
      "value": " 5555-5555-5555-4444\n",
      "capture": false
    },
    {
      "name": "card number failing Luhn",
      "value": "4111 1111 1111 1112",
      "capture": true
    },
    {
      "name": "short digit run",
      "value": "411111111111",
      "capture": true
    },
    {
      "name": "card number inside a sentence",
      "value": "Order 4111111111111111 shipped",
      "capture": true
    },
    {
      "name": "grouped IBAN",
      "value": "TR33 0006 1005 1978 6457 8413 26",
      "capture": false
    },
    {
      "name": "lowercase compact IBAN",
      "value": "gb82west12345698765432",
      "capture": false
    },
    {
      "name": "IBAN with wrong check digits",
      "value": "DE88 3704 0044 0532 0130 00",
      "capture": true
    },
    {
      "name": "IBAN-shaped word",
      "value": "AB12 HELLO WORLD",
      "capture": true
    },
    {
      "name": "two card numbers on separate lines",
      "value": "4111 1111 1111 1111\n5555 5555 5555 4444",
      "capture": true
    },
    {
      "name": "labelled card number",
      "value": "Card: 4111 1111 1111 1111",
      "capture": true
    },
    {
      "name": "IBAN inside a sentence",
      "value": "Pay GB82 WEST 1234 5698 7654 32 today",
      "capture": true
    },
    {
      "name": "labelled IBAN",
      "value": "IBAN: TR33 0006 1005 1978 6457 8413 26",
      "capture": true
    }
  ]
}
