{
  "schemaVersion": 1,
  "description": "Copied content admission before history, previews, indexing or metadata. Private markers on any item exclude the whole copy; nonblank text bytes stay exact.",
  "privateMarkers": [
    "org.nspasteboard.ConcealedType",
    "org.nspasteboard.TransientType",
    "org.nspasteboard.AutoGeneratedType",
    "com.agilebits.onepassword"
  ],
  "linkedRepresentationCases": [
    {
      "name": "HTML anchor with a plain display label",
      "formats": {"text/plain": "Read docs", "text/html": "<a href=\"https://example.com/docs?a=1&amp;b=2\">Read docs</a>"},
      "url": "https://example.com/docs?a=1&b=2"
    },
    {
      "name": "URI list with a comment and a display label",
      "formats": {"text/plain": "Read docs", "text/uri-list": "# copied URL\r\nhttps://example.com/from-uri\r\n"},
      "url": "https://example.com/from-uri"
    },
    {
      "name": "only HTML URL no plain-text representation",
      "formats": {"text/html": "<a title='docs' href='https://example.com/html-only'>Read docs</a>"},
      "url": "https://example.com/html-only"
    }
  ],
  "textCases": [
    {
      "name": "spaces",
      "value": "   ",
      "capture": false
    },
    {
      "name": "tabs and newlines",
      "value": "\t\r\n",
      "capture": false
    },
    {
      "name": "Unicode whitespace",
      "value": "    ",
      "capture": false
    },
    {
      "name": "padded exact text",
      "value": "  İstanbul 👨‍👩‍👧‍👦\r\nnext line\t",
      "capture": true
    },
    {
      "name": "zero width is content",
      "value": " ​ ",
      "capture": true
    },
    {
      "name": "BOM is content",
      "value": "﻿",
      "capture": true
    }
  ]
}
