{
  "name": "clipboardline-desktop",
  "version": "1.7.8",
  "description": "Keyboard-first local clipboard shelves and saved library for Windows and Linux",
  "author": "ClipBoardLine contributors",
  "license": "MIT",
  "homepage": "https://github.com/orkunisitmak/clipboardline",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "dist:linux": "electron-builder --linux --x64 --publish never",
    "test:linux": "node tests/linux-acceptance.cjs"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/tur": "1.0.0",
    "onnxruntime-web": "1.30.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "electron": "44.9.1",
    "electron-builder": "26.15.3",
    "playwright": "1.64.1"
  },
  "overrides": {
    "global-agent": "4.1.3"
  },
  "build": {
    "appId": "com.clipboardline.desktop.windows",
    "productName": "ClipBoardLine",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "lib/**/*.cjs",
      "native/*.ps1",
      "index.html",
      "locales.js",
      "renderer.js",
      "styles.css",
      "assets/**/*",
      "search-model-config.json",
      "package.json",
      "!assets/CLIP/**"
    ],
    "extraResources": [
      {
        "from": "node_modules/@tesseract.js-data",
        "to": "ocr-data",
        "filter": [
          "**/4.0.0_best_int/*.traineddata.gz"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "WINDOWS_THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "assets/licenses",
        "to": "licenses"
      },
      {
        "from": "assets/CLIP",
        "to": "CLIP",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "icon": "assets/clipboardline.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClipBoardLine-Setup-${version}-${arch}.${ext}",
      "extraResources": [
        {
          "from": "native",
          "to": "native",
          "filter": [
            "*.ps1"
          ]
        }
      ]
    },
    "nsis": {
      "installerIcon": "assets/clipboardline.ico",
      "uninstallerIcon": "assets/clipboardline.ico",
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": false
    },
    "asarUnpack": [
      "lib/*.cjs",
      "node_modules/onnxruntime-web/**",
      "node_modules/onnxruntime-common/**"
    ],
    "linux": {
      "icon": "assets/clipboardline.png",
      "executableName": "clipboardline",
      "category": "Utility",
      "synopsis": "Keyboard-first clipboard shelves and library",
      "description": "Local clipboard shelves for images, text and links with a saved, searchable library.",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "pacman",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "ClipBoardLine-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "ClipBoardLine",
          "Comment": "Keyboard-first clipboard shelves and library",
          "Keywords": "clipboard;history;paste;screenshot;",
          "StartupNotify": "false"
        }
      },
      "maintainer": "ClipBoardLine contributors <noreply@github.com>"
    },
    "deb": {
      "recommends": [
        "wl-clipboard",
        "xclip",
        "xdotool",
        "ydotool",
        "ffmpeg",
        "spectacle | gnome-screenshot | grim"
      ]
    },
    "pacman": {
      "depends": [
        "gtk3",
        "nss",
        "alsa-lib",
        "libxss",
        "libxtst"
      ]
    },
    "afterAllArtifactBuild": "scripts/pacman-optdepends.cjs"
  },
  "clipboardLineBuild": 71,
  "clipboardLineLinux": {
    "pacmanOptionalDepends": [
      "wl-clipboard: Wayland clipboard access",
      "xclip: X11 clipboard access",
      "xdotool: X11 automatic paste",
      "ydotool: Wayland automatic paste",
      "ffmpeg: screen recordings",
      "spectacle: KDE screenshots"
    ]
  }
}
